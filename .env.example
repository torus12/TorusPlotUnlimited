# TorusPlot optional AI settings. Copy this file to ".env" and fill in ONLY what you use.
# AI features are OFF by default and TorusPlot works fully offline without any of these.
# Never commit your real .env file (it is gitignored).

# Which provider to use: mock | ollama | gemini | anthropic | openai
TORUSPLOT_AI_PROVIDER=mock

# Free + local (no key needed): install Ollama from https://ollama.com and pull a model.
OLLAMA_HOST=http://localhost:11434
TORUSPLOT_OLLAMA_TEXT_MODEL=
TORUSPLOT_OLLAMA_VISION_MODEL=

# Bring-your-own-key cloud providers (each provider's own terms apply to your account).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TORUSPLOT_GEMINI_MODEL=
TORUSPLOT_ANTHROPIC_MODEL=
TORUSPLOT_OPENAI_MODEL=

# Master switch (AI features stay off unless this is 1)
TORUSPLOT_AI_ENABLED=0
# Optional tuning
OPENAI_BASE_URL=
TORUSPLOT_AI_TIMEOUT=120
TORUSPLOT_AI_MAX_RETRIES=3
TORUSPLOT_AI_MAX_FEEDBACK_LOOPS=3
